<Window x:Class="ALE.ACS.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:panes="clr-namespace:ALE.ACS.Presentation.Shell.Panes"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="900"
        Width="1600"
        MinHeight="700"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- MENU -->
        <Menu DockPanel.Dock="Top">

            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Novo Projeto..."
                          Command="{Binding NewProjectCommand}" />
                <MenuItem Header="_Abrir Projeto..." />
                <Separator/>
                <MenuItem Header="_Sair"/>
            </MenuItem>

            <MenuItem Header="_Projeto"/>
            <MenuItem Header="_Controladores"/>
            <MenuItem Header="_Ferramentas"/>
            <MenuItem Header="_Exibir"/>
            <MenuItem Header="_Ajuda"/>

        </Menu>

        <!-- TOOLBAR -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar/>
        </ToolBarTray>

        <!-- STATUS -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- SHELL -->
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Project Explorer -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    BorderBrush="#C0C0C0"
                    BorderThickness="1">

                <panes:ProjectExplorerPane/>

            </Border>

            <!-- Splitter Esquerdo -->
            <GridSplitter Grid.Row="0"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"/>

            <!-- Workspace -->
            <Border Grid.Row="0"
                    Grid.Column="2"
                    BorderBrush="#C0C0C0"
                    BorderThickness="1">

                <Grid Margin="16">

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Workspace"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding WorkspaceContent}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                </Grid>

            </Border>

            <!-- Splitter Direito -->
            <GridSplitter Grid.Row="0"
                          Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"/>

            <!-- Properties -->
            <Border Grid.Row="0"
                    Grid.Column="4"
                    BorderBrush="#C0C0C0"
                    BorderThickness="1">

                <Grid Margin="16">

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Properties"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding PropertiesContent}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                </Grid>

            </Border>

            <!-- Splitter Inferior -->
            <GridSplitter Grid.Row="1"
                          Grid.ColumnSpan="5"
                          Height="5"
                          VerticalAlignment="Stretch"/>

            <!-- Output -->
            <Border Grid.Row="2"
                    Grid.ColumnSpan="5"
                    BorderBrush="#C0C0C0"
                    BorderThickness="1">

                <Grid>

                    <TextBlock Text="Output"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Grid>

            </Border>

        </Grid>

    </DockPanel>

</Window>