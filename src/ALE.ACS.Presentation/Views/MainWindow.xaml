<Window x:Class="ALE.ACS.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:panes="clr-namespace:ALE.ACS.Presentation.Shell.Panes"
        mc:Ignorable="d"
        Style="{StaticResource MainWindowStyle}"
        Title="{Binding WindowTitle}"
        Height="750"
        Width="1200"
        MinHeight="550"
        MinWidth="900"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel>

        <!-- ===== TITLEBAR (custom, mimics preview-ui-fase2.html) ===== -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Height="36">
            <Grid Margin="12,0,8,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="18" Height="18"
                            CornerRadius="4"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,0,6,0">
                        <TextBlock Text="A"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ALE ACS"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Breadcrumb -->
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding ProjectStatus, Mode=OneWay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding DocumentStatus, Mode=OneWay}"/>
                </TextBlock>

                <!-- Action icons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0">
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding RunSimulationCommand}"
                            ToolTip="Run / Simulate"
                            Content="▶"/>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding RunValidationCommand}"
                            ToolTip="Validate"
                            Content="✓"/>
                </StackPanel>

                <!-- Theme toggle pill -->
                <Button Grid.Column="3"
                        Style="{StaticResource ThemedButton}"
                        Padding="10,4"
                        FontSize="11"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Command="{Binding CycleThemeCommand}"
                        ToolTip="Alternar tema (Auto / Light / Dark)"
                        Content="🎨 Theme"/>

                <!-- Output mode toggle pill -->
                <Button Grid.Column="4"
                        Style="{StaticResource ThemedButton}"
                        Padding="10,4"
                        FontSize="11"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleOutputModeCommand}"
                        ToolTip="Output: painel inferior ↔ aba no content"
                        Content="📊 Output"/>

            </Grid>
        </Border>

        <!-- ===== MENU (kept from original, themed via MenuItem style) ===== -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource PanelBackgroundBrush}">

            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Novo Projeto..."
                          Command="{Binding NewProjectCommand}" />
                <MenuItem Header="_Abrir Projeto..."
                          Command="{Binding OpenProjectCommand}"/>
                <MenuItem Header="_Salvar"
                          Command="{Binding SaveProjectCommand}"/>
                <MenuItem Header="Salvar _Como"
                          Command="{Binding SaveProjectAsCommand}"/>
                <MenuItem Header="_Fechar"
                          Command="{Binding CloseProjectCommand}"/>
                <Separator/>

                <MenuItem Header="_Recentes"
                          ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command"
                                    Value="{Binding DataContext.OpenRecentProjectCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter"
                                    Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>

                <Separator/>

                <MenuItem Header="_Sair"
                          Command="{Binding ExitApplicationCommand}"/>
            </MenuItem>

            <MenuItem Header="_Projeto">
                <MenuItem Header="_Novo Projeto"
                          Command="{Binding NewProjectCommand}"/>
                <MenuItem Header="Novo _Modelo"
                          Command="{Binding NewModelCommand}"/>
                <MenuItem Header="_Abrir Projeto"
                          Command="{Binding OpenProjectCommand}"/>
                <MenuItem Header="_Fechar Projeto"
                          Command="{Binding CloseProjectCommand}"/>
                <Separator/>
                <MenuItem Header="_Salvar Projeto"
                          Command="{Binding SaveProjectCommand}"/>
                <MenuItem Header="Salvar Projeto _Como"
                          Command="{Binding SaveProjectAsCommand}"/>
                <Separator/>
                <MenuItem Header="Projetos _Recentes"
                          ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command"
                                    Value="{Binding DataContext.OpenRecentProjectCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter"
                                    Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Controladores">
                <MenuItem Header="Novo _Fuzzy Controller"
                          Command="{Binding NewFuzzyControllerCommand}"/>
                <MenuItem Header="Novo _MPC Controller"
                          Command="{Binding NewMpcControllerCommand}"/>
                <MenuItem Header="Novo _Adaptive Controller"
                          Command="{Binding NewAdaptiveControllerCommand}"/>
                <MenuItem Header="Novo _Neural Controller"
                          Command="{Binding NewNeuralControllerCommand}"/>
                <MenuItem Header="Novo _Identification Controller"
                          Command="{Binding NewIdentificationControllerCommand}"/>
                <MenuItem Header="Novo _Optimization Controller"
                          Command="{Binding NewOptimizationControllerCommand}"/>
                <MenuItem Header="Novo _PID Controller"
                          Command="{Binding NewPidControllerCommand}"/>
            </MenuItem>

            <MenuItem Header="_Ferramentas">
                <MenuItem Header="_Validation"
                          Command="{Binding RunValidationCommand}"/>
                <MenuItem Header="_Simulation"
                          Command="{Binding RunSimulationCommand}"/>
                <MenuItem Header="_Options"
                          Command="{Binding OpenOptionsCommand}"/>
            </MenuItem>

            <MenuItem Header="_Exibir">
                <MenuItem Header="_Explorer"
                          Command="{Binding ToggleExplorerCommand}"/>
                <MenuItem Header="_Workspace"
                          Command="{Binding ToggleWorkspaceCommand}"/>
                <MenuItem Header="_Properties"
                          Command="{Binding TogglePropertiesCommand}"/>
                <MenuItem Header="_Output"
                          Command="{Binding ToggleOutputCommand}"/>
                <MenuItem Header="_Status Bar"
                          Command="{Binding ToggleStatusBarCommand}"/>
            </MenuItem>

            <MenuItem Header="_Ajuda">
                <MenuItem Header="_About ALE ACS"
                          Command="{Binding ShowAboutCommand}"/>
                <MenuItem Header="_Documentation"
                          Command="{Binding OpenDocumentationCommand}"/>
                <MenuItem Header="_Release Notes"
                          Command="{Binding OpenReleaseNotesCommand}"/>
            </MenuItem>

        </Menu>

        <!-- ===== STATUS BAR (kept from original, themed) ===== -->
        <StatusBar DockPanel.Dock="Bottom"
                   Visibility="{Binding IsStatusBarVisible,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
            <StatusBarItem>
                <TextBlock Text="{Binding ProjectStatus,
                                  StringFormat='Project: {0}'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding DocumentStatus,
                                  StringFormat='Document: {0}'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StateStatus,
                                  StringFormat='State: {0}'}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== MAIN BODY: Sidebar | Splitter | Content (with bottom output panel) ===== -->
        <Grid>

            <!-- ===== SIDEBAR (Explorer + Properties unified) ===== -->
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"
                                      MinWidth="200"
                                      MaxWidth="400"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar content: Explorer pane on top, Properties pane on bottom -->
                <Grid Grid.Column="0"
                      Visibility="{Binding IsExplorerVisible,
                                  Converter={StaticResource BooleanToVisibilityConverter}}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Explorer (tree) -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource SidebarBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,1,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="EXPLORER"
                                       Style="{StaticResource MutedText}"
                                       FontWeight="SemiBold"
                                       Margin="12,8,8,4"/>
                            <panes:ProjectExplorerPane/>
                        </DockPanel>
                    </Border>

                    <!-- Horizontal splitter -->
                    <GridSplitter Grid.Row="1"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  Background="{DynamicResource BorderBrush}"
                                  Visibility="{Binding IsPropertiesVisible,
                                              Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Properties (selected item) -->
                    <Border Grid.Row="2"
                            Height="200"
                            MinHeight="120"
                            Background="{DynamicResource SidebarBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="{Binding IsPropertiesVisible,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">

                        <DockPanel Margin="12,8,12,12">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="PROPERTIES"
                                       Style="{StaticResource MutedText}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>

                                    <TextBlock Text="Name"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,2"/>
                                    <TextBox Style="{StaticResource ThemedTextBox}"
                                             Margin="0,0,0,8"
                                             Text="{Binding SelectedName,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="Type"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,2"/>
                                    <!-- REMED-001: trocado TextBox IsReadOnly por ComboBox.
                                         Antes, SelectedType era string livre e o usuário
                                         digitava valores inválidos, fazendo o editor
                                         especializado nunca carregar. Agora só aceita
                                         tipos que o WorkspaceView.xaml reconhece. -->
                                    <ComboBox Margin="0,0,0,8"
                                              ItemsSource="{Binding AvailableControllerTypes}"
                                              SelectedItem="{Binding SelectedType,
                                                                     Mode=TwoWay,
                                                                     UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="Description"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,2"/>
                                    <TextBox Style="{StaticResource ThemedTextBox}"
                                             Margin="0,0,0,8"
                                             Height="80"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding SelectedDescription,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"/>

                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Apply"
                                            HorizontalAlignment="Left"
                                            Margin="0,4,0,12"
                                            Command="{Binding ApplyPropertiesCommand}"/>

                                    <TextBlock Text="{Binding PropertiesContent}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource MutedText}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                </Grid>

                <!-- Vertical splitter between sidebar and content -->
                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"
                              Visibility="{Binding IsWorkspaceVisible,
                                          Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- ===== CONTENT: Tabs (Designer | Output-when-tab-mode) + Bottom Output panel ===== -->
                <Grid Grid.Column="2"
                      Visibility="{Binding IsWorkspaceVisible,
                                  Converter={StaticResource BooleanToVisibilityConverter}}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="180"
                                       MinHeight="100"
                                       MaxHeight="500"/>
                    </Grid.RowDefinitions>

                    <!-- Content header: title + actions + tabs -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,1,0">
                        <DockPanel>

                            <!-- Toolbar -->
                            <Border DockPanel.Dock="Top"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DocumentStatus}"
                                                   Style="{StaticResource HeadingText}"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource ThemedButton}"
                                                Content="Validate"
                                                Margin="0,0,6,0"
                                                Command="{Binding RunValidationCommand}"/>
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="▶ Simulate"
                                                Command="{Binding RunSimulationCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Tabs (Output tab only shows when OutputModeIsTab=true) -->
                            <Border DockPanel.Dock="Top"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Background="{DynamicResource PanelBackgroundBrush}">
                                <TabControl Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8,0">

                                    <TabItem Header="Designer">
                                        <ContentControl Content="{Binding WorkspaceView}" />
                                    </TabItem>

                                    <TabItem Header="Output"
                                             Visibility="{Binding OutputModeIsTab,
                                                         Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBox Text="{Binding OutputText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 Background="{DynamicResource BackgroundBrush}"
                                                 BorderThickness="0"
                                                 Padding="8"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 FontSize="12"/>
                                    </TabItem>
                                </TabControl>
                            </Border>

                        </DockPanel>
                    </Border>

                    <!-- ===== BOTTOM OUTPUT PANEL (only when OutputVisible=true) ===== -->
                    <!-- GridSplitter horizontal: permite redimensionar o painel de output -->
                    <GridSplitter Grid.Row="1"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True"
                                  Background="{DynamicResource BorderBrush}"
                                  Cursor="SizeNS"
                                  Visibility="{Binding IsOutputVisible,
                                              Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Border Grid.Row="2"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="{Binding IsOutputVisible,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>

                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource PanelAltBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="🖥️ OUTPUT"
                                               Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StateStatus, StringFormat=' · {0}'}"
                                               Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <TextBox Text="{Binding OutputText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Background="{DynamicResource BackgroundBrush}"
                                     BorderThickness="0"
                                     Padding="10"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="12"/>
                        </DockPanel>
                    </Border>

                </Grid>

            </Grid>

        </Grid>

    </DockPanel>

</Window>
