<Window x:Class="ALE.ACS.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ALE Advanced Control Studio"
        Height="800"
        Width="1400"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen">

    <DockPanel LastChildFill="True">

        <!-- MENU PRINCIPAL -->
        <Menu DockPanel.Dock="Top">

            <MenuItem Header="_Arquivo">

                <MenuItem Header="_Novo Projeto..."
                          Command="{Binding NewProjectCommand}" />

                <MenuItem Header="_Abrir Projeto..." />

                <Separator/>

                <MenuItem Header="_Sair"/>

            </MenuItem>

            <MenuItem Header="_Projeto"/>

            <MenuItem Header="_Exibir"/>

            <MenuItem Header="_Ferramentas"/>

            <MenuItem Header="_Ajuda"/>

        </Menu>

        <!-- TOOLBAR (Reservada para futuras funcionalidades) -->
        <ToolBarTray DockPanel.Dock="Top">

            <ToolBar>

            </ToolBar>

        </ToolBarTray>

        <!-- STATUS BAR -->
        <StatusBar DockPanel.Dock="Bottom">

            <StatusBarItem>

                <TextBlock Text="Pronto"/>

            </StatusBarItem>

        </StatusBar>

        <!-- ÁREA PRINCIPAL -->
        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="260"/>

                <ColumnDefinition Width="5"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <!-- Explorer -->
            <Border Grid.Column="0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="0,0,1,0"
                    Background="#F8F8F8">

                <StackPanel Margin="10">

                    <TextBlock Text="Solution Explorer"
                               FontWeight="Bold"
                               FontSize="14"/>

                    <Separator Margin="0,8"/>

                    <TextBlock Text="Nenhum projeto aberto"
                               Foreground="Gray"/>

                </StackPanel>

            </Border>

            <!-- Separador -->

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"/>

            <!-- Workspace -->

            <Grid Grid.Column="2">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock
                        Text="ALE Advanced Control Studio"
                        FontSize="28"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Margin="0,15,0,0"
                        Text="Plataforma para Engenharia de Controle Avançado"
                        FontSize="15"
                        Foreground="Gray"
                        HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Grid>

    </DockPanel>

</Window>