<Window x:Class="ALE.ACS.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:panes="clr-namespace:ALE.ACS.Presentation.Shell.Panes"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="900"
        Width="1600"
        MinHeight="700"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- MENU -->
        <Menu DockPanel.Dock="Top">

            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Novo Projeto..."
                          Command="{Binding NewProjectCommand}" />
                <MenuItem Header="_Abrir Projeto..."
                          Command="{Binding OpenProjectCommand}"/>
                <MenuItem Header="_Salvar"
                          Command="{Binding SaveProjectCommand}"/>
                <MenuItem Header="Salvar _Como"
                          Command="{Binding SaveProjectAsCommand}"/>
                <MenuItem Header="_Fechar"
                          Command="{Binding CloseProjectCommand}"/>
                <Separator/>
                <MenuItem Header="_Recentes"
                          ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Sair"
                          Command="{Binding ExitApplicationCommand}"/>
            </MenuItem>

            <MenuItem Header="_Projeto"/>
            <MenuItem Header="_Controladores"/>
            <MenuItem Header="_Ferramentas"/>
            <MenuItem Header="_Exibir"/>
            <MenuItem Header="_Ajuda"/>

        </Menu>

        <!-- TOOLBAR -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
            <Button Content="Novo"
                Command="{Binding NewProjectCommand}"/>
            <Button Content="Abrir"
                Command="{Binding OpenProjectCommand}"/>
            <Button Content="Salvar"
                Command="{Binding SaveProjectCommand}"/>
            <Button Content="Fechar"
                Command="{Binding CloseProjectCommand}"/>
            <Separator/>
            <Button Content="Undo"
                Command="{Binding UndoCommand}"/>
            <Button Content="Redo"
                Command="{Binding RedoCommand}"/>
            </ToolBar>
        </ToolBarTray>

        <!-- STATUS -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding ProjectStatus, StringFormat='Project: {0}'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding DocumentStatus, StringFormat='Document: {0}'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StateStatus, StringFormat='State: {0}'}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- SHELL -->
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Project Explorer -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    BorderBrush="#C0C0C0"
                    BorderThickness="1">

                <panes:ProjectExplorerPane/>

            </Border>

            <!-- Splitter Esquerdo -->
            <GridSplitter Grid.Row="0"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"/>

            <!-- Workspace -->
            <Border Grid.Row="0"
                    Grid.Column="2"
                    BorderBrush="#C0C0C0"
                    BorderThickness="1">

                <ContentControl Content="{Binding WorkspaceView}" />

            </Border>

            <!-- Splitter Direito -->
            <GridSplitter Grid.Row="0"
                          Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"/>

            <!-- Properties -->
            <Border Grid.Row="0"
                    Grid.Column="4"
                    BorderBrush="#C0C0C0"
                    BorderThickness="1">

                <Grid Margin="16">

                    <StackPanel>
                        <TextBlock Text="Properties"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="0,0,0,12"
                                   Foreground="#505050"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Name"/>
                        <TextBox Margin="0,4,0,8"
                                 Text="{Binding SelectedName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Type"/>
                        <TextBox Margin="0,4,0,8"
                                 Text="{Binding SelectedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Description"/>
                        <TextBox Margin="0,4,0,8"
                                 Height="120"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding SelectedDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="Apply"
                                HorizontalAlignment="Left"
                                Padding="12,4"
                                Command="{Binding ApplyPropertiesCommand}"/>

                        <TextBlock Margin="0,12,0,0"
                                   Text="{Binding PropertiesContent}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                </Grid>

            </Border>

            <!-- Splitter Inferior -->
            <GridSplitter Grid.Row="1"
                          Grid.ColumnSpan="5"
                          Height="5"
                          VerticalAlignment="Stretch"/>

            <!-- Output -->
            <Border Grid.Row="2"
                    Grid.ColumnSpan="5"
                    BorderBrush="#C0C0C0"
                    BorderThickness="1">

                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Output"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding OutputEntries}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="140"
                                                Header="Time"
                                                DisplayMemberBinding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"/>
                                <GridViewColumn Width="100"
                                                Header="Level"
                                                DisplayMemberBinding="{Binding Level}"/>
                                <GridViewColumn Width="900"
                                                Header="Message"
                                                DisplayMemberBinding="{Binding Message}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

            </Border>

        </Grid>

    </DockPanel>

</Window>