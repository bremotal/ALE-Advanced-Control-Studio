<UserControl x:Class="ALE.ACS.Presentation.Controllers.Neural.Views.NeuralEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ALE.ACS.Presentation;component/Controllers/Common/Resources/ControllerEditorResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="16">
        <StackPanel Orientation="Vertical">

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="{Binding Controller.Name}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextForegroundBrush}"/>
                    <TextBlock Text="{Binding Controller.Description}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="8,3"
                        CornerRadius="10"
                        Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding Controller.ControllerKind}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </Border>
            </Grid>

            <!-- Seletor de seção ativa -->
            <ListBox ItemsSource="{Binding Controller.Sections}"
                     SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                     Background="{DynamicResource PanelAltBackgroundBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     Foreground="{DynamicResource TextForegroundBrush}"
                     Margin="0,0,0,12">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="{Binding Icon}"
                                       Margin="0,0,6,0"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding Title}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Card da seção ativa -->
            <ContentControl Content="{Binding SelectedSection}"
                            ContentTemplate="{StaticResource ControllerSectionCardTemplate}"/>

            <!-- Linha Add/Remove -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource ThemedTextBox}"
                         Margin="0,0,6,0"/>
                <Button Grid.Column="1"
                        Content="+ Add"
                        Command="{Binding AddItemCommand}"
                        Style="{DynamicResource PrimaryButton}"
                        Padding="12,4"
                        Margin="0,0,4,0"/>
                <Button Grid.Column="2"
                        Content="− Remove"
                        Command="{Binding RemoveItemCommand}"
                        Style="{DynamicResource MiniButton}"
                        Padding="10,4"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
