<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataTemplate para item de uma seção (bullet + texto) -->
    <DataTemplate x:Key="ControllerSectionItemTemplate">
        <StackPanel Orientation="Horizontal" Margin="0,2">
            <TextBlock Text="●"
                       Margin="0,0,8,0"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{Binding}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextForegroundBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </DataTemplate>

    <!-- DataTemplate para uma seção inteira (header + lista + Add/Remove) -->
    <DataTemplate x:Key="ControllerSectionCardTemplate">
        <Border Margin="0,0,8,8"
                Padding="14"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header da seção -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Icon}"
                               Margin="0,0,8,0"
                               FontSize="14"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextForegroundBrush}"/>
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Bottom"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}">
                        <Run Text="("/><Run Text="{Binding Items.Count}"/><Run Text=")"/>
                    </TextBlock>
                </StackPanel>

                <!-- Lista de itens — SelectedItem binda para o VM via UserControl ancestral -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                         Background="{DynamicResource PanelAltBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         Foreground="{DynamicResource TextForegroundBrush}"
                         ItemTemplate="{StaticResource ControllerSectionItemTemplate}"/>

                <!-- Hint -->
                <TextBlock Grid.Row="2"
                           Margin="0,4,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="{Binding Hint}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
