<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== DataTemplate para itens genéricos (Inputs, Outputs, MembershipFunctions) ===== -->
    <!-- Cada item mostra um bullet colorido + texto, com padding e fundo transparente
         (o tema pinta o ListItem via ListBoxItem style global). -->
    <DataTemplate x:Key="FuzzyItemTemplate">
        <StackPanel Orientation="Horizontal"
                    Margin="0,2">
            <TextBlock Text="●"
                       Margin="0,0,8,0"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{Binding}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextForegroundBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </DataTemplate>

    <!-- ===== DataTemplate para regras (Rule Base) ===== -->
    <!-- Regras são strings longas: usamos fonte monoespaçada e wrap para legibilidade. -->
    <DataTemplate x:Key="FuzzyRuleTemplate">
        <StackPanel Orientation="Vertical"
                    Margin="0,2">
            <TextBlock Text="{Binding}"
                       FontSize="12"
                       FontFamily="{StaticResource MonoFontFamily}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextForegroundBrush}"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
