<Window x:Class="ALE.ACS.Presentation.Shell.Dialogs.Projects.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo Projeto"
        Height="220"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <TextBlock
            Grid.Row="0"
            Text="Criar Novo Projeto"
            FontSize="20"
            FontWeight="SemiBold"/>

        <!-- Conteúdo -->
        <StackPanel Grid.Row="2">

            <TextBlock
                Margin="0,0,0,6"
                Text="Nome do Projeto"/>

            <TextBox
                x:Name="ProjectNameTextBox"
                Height="32"
                VerticalContentAlignment="Center"/>

        </StackPanel>

        <!-- Rodapé -->
        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Width="100"
                Margin="0,0,10,0"
                IsCancel="True"
                Content="Cancelar"/>

            <Button
                Width="100"
                IsDefault="True"
                Content="Criar"/>

        </StackPanel>

    </Grid>

</Window>