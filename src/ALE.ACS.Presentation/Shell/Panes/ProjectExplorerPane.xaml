<UserControl x:Class="ALE.ACS.Presentation.Shell.Panes.ProjectExplorerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ALE.ACS.Presentation.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="300">

    <Border Padding="8"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0"
        Background="Transparent">

        <TreeView ItemsSource="{Binding ProjectItems}"
                  behaviors:TreeViewSelectionBehavior.SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                  BorderThickness="0"
                  Background="Transparent"
                  Foreground="{DynamicResource TextForegroundBrush}">

            <TreeView.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick"
                              Command="{Binding OpenSelectedNodeCommand}" />
            </TreeView.InputBindings>

            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                    <!-- O Tag de cada TreeViewItem aponta para o DataContext (MainWindowViewModel) -->
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <!-- O PlacementTarget é o TreeViewItem, e o Tag dele contém o ViewModel -->
                                <MenuItem Header="Novo Modelo"
                                          Command="{Binding PlacementTarget.Tag.NewModelCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                <MenuItem Header="Novo Controlador"
                                          Command="{Binding PlacementTarget.Tag.NewControllerCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Open"
                                          Command="{Binding PlacementTarget.Tag.OpenSelectedNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Rename"
                                          Command="{Binding PlacementTarget.Tag.RenameSelectedNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator/>
                                <MenuItem Header="Expand"
                                          Command="{Binding PlacementTarget.Tag.ExpandSelectedNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Collapse"
                                          Command="{Binding PlacementTarget.Tag.CollapseSelectedNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}"
                     Foreground="{DynamicResource TextForegroundBrush}"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>

        </TreeView>

    </Border>

</UserControl>