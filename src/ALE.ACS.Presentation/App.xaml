<Application x:Class="ALE.ACS.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  Slot dinâmico para o tema ativo.
                  O ThemeManager.cs troca o Source deste dicionário entre
                  Shell/Themes/LightTheme.xaml e Shell/Themes/DarkTheme.xaml
                  em tempo de execução (Auto / Light / Dark).
                -->
                <ResourceDictionary Source="Shell/Themes/LightTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Application.Resources>

</Application>