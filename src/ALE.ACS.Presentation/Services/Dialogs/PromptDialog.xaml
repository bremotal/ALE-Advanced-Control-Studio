<Window x:Class="ALE.ACS.Presentation.Services.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entrada"
        Height="240"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                    x:Name="TitleLabel"
                    FontSize="16"
                    FontWeight="SemiBold"/>

        <!-- Mensagem -->
        <TextBlock Grid.Row="2"
                    x:Name="MessageLabel"
                    Margin="0,0,0,6"/>

        <!-- Botões -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    Width="100"
                    Height="30"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancel"/>
            <Button Content="OK"
                    Width="100"
                    Height="30"
                    IsDefault="True"
                    Click="OnOk"/>
        </StackPanel>

        <!-- Caixa de texto (Row 3 com TextBox absoluto para ficar abaixo da mensagem) -->
        <TextBox Grid.Row="3"
                    x:Name="ValueBox"
                    Height="32"
                    Margin="0,12,0,12"
                    VerticalContentAlignment="Center"
                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

    </Grid>

</Window>
